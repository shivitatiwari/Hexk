# Never commit real values. For deployed Workers, set these with `wrangler secret put`.
TRACKER_API_KEY=replace-with-a-long-random-secret
AGENT_READ_TOKEN=replace-with-a-different-long-random-secret

# Optional: one extra browser origin allowed to call /api/*.
# Same-origin dashboard requests do not need this.
ALLOWED_ORIGIN=https://example.com
